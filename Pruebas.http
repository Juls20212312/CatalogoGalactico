@host = https://localhost:5001

### 1. Comprobar API
GET {{host}}/
Accept: text/plain

### 2. Obtener personajes
GET {{host}}/personajes/
Accept: application/json

### 3. Obtener personaje por ID
GET {{host}}/personajes/1
Accept: application/json

### 4. Filtrar personajes
GET {{host}}/personajes/?faccion=Imperio&fuerzaSensitivo=true
Accept: application/json

### 5. Ranking por poder
GET {{host}}/personajes/ranking?por=poder
Accept: application/json

### 6. Eventos de un personaje
GET {{host}}/personajes/1/eventos
Accept: application/json

### 7. Obtener cartas
GET {{host}}/cartas/
Accept: application/json

### 8. Obtener carta
GET {{host}}/cartas/1
Accept: application/json

### 9. Obtener eventos
GET {{host}}/eventos/
Accept: application/json

### 10. Obtener evento
GET {{host}}/eventos/1
Accept: application/json

### 11. MVP
GET {{host}}/eventos/1/mvp
Accept: application/json

### 12. Simulación
POST {{host}}/eventos/1/simular
Accept: application/json
### 13. Crear personaje
POST {{host}}/personajes/
Content-Type: application/json

{
  "nombre": "Obi-Wan Kenobi",
  "especie": "Humano",
  "faccion": "Neutral",
  "afiliacion": "Orden Jedi",
  "estado": "Vivo",
  "fuerzaSensitivo": true
}
### 14. Crear carta
POST {{host}}/cartas/
Content-Type: application/json

{
  "personajeId": 7,
  "poder": 95,
  "habilidadEspecial": "Maestro Jedi",
  "arma": "Sable de luz",
  "nivelPeligrosidad": 9,
  "imagenUrl": "https://example.com/obiwan.jpg"
}
### 15. Crear evento
POST {{host}}/eventos/
Content-Type: application/json

{
  "nombre": "Encuentro en Tatooine",
  "fecha": -10,
  "ubicacion": "Tatooine",
  "descripcion": "Evento de prueba para el catálogo.",
  "participantesIds": [1, 4, 7],
  "ganadorId": 1,
  "resultado": "Victoria rebelde",
  "muertosIds": []
}
### 16. Evento con un solo participante
POST {{host}}/eventos/
Content-Type: application/json

{
  "nombre": "Evento inválido",
  "fecha": 30,
  "ubicacion": "Tatooine",
  "descripcion": "Debe fallar.",
  "participantesIds": [1],
  "ganadorId": 1,
  "resultado": "Prueba",
  "muertosIds": []
}
### 17. Intentar crear otra carta para Luke
POST {{host}}/cartas/
Content-Type: application/json

{
  "personajeId": 1,
  "poder": 150,
  "habilidadEspecial": "Otra habilidad",
  "arma": "Sable",
  "nivelPeligrosidad": 10,
  "imagenUrl": "https://example.com/test.jpg"
}
### 18. Personaje inexistente
GET {{host}}/personajes/999
Accept: application/json
### 19. Registrar una muerte
POST {{host}}/eventos/
Content-Type: application/json

{
  "nombre": "Batalla final de prueba",
  "fecha": 100,
  "ubicacion": "Planeta desconocido",
  "descripcion": "Prueba de actualización automática de estado.",
  "participantesIds": [3, 4],
  "ganadorId": 4,
  "resultado": "Victoria imperial",
  "muertosIds": [3]
}
### 20. Comprobar estado del personaje
GET {{host}}/personajes/3
Accept: application/json
### 21. Intentar usarlo en un evento posterior
POST {{host}}/eventos/
Content-Type: application/json

{
  "nombre": "Evento posterior a la muerte",
  "fecha": 101,
  "ubicacion": "Planeta desconocido",
  "descripcion": "Debe ser rechazado.",
  "participantesIds": [3, 4],
  "ganadorId": 4,
  "resultado": "Prueba",
  "muertosIds": []
}